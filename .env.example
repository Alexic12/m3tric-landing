# Configuración pública de la landing (se incrusta en el HTML en build).
# Copie a .env.production.local y complete con los valores APROBADOS.
# `npm run release` falla si falta alguna obligatoria o si apunta a localhost/example.

# Obligatoria en release. Perfil: staging | production. staging => noindex y correo opcional.
RELEASE_PROFILE=
# Obligatoria en release. Debe ser igual a RELEASE_PROFILE (la lee la app en build).
NEXT_PUBLIC_RELEASE_PROFILE=
# Opcional. Identificador del despliegue (letras, dígitos, ._-; máx. 64). Vacío = "local".
NEXT_PUBLIC_RELEASE_ID=

# Obligatoria. Dominio productivo, https, sin barra final. Ej.: https://m3tric.co
NEXT_PUBLIC_SITE_URL=

# Obligatoria. URL oficial de la pantalla de acceso de la plataforma, https.
NEXT_PUBLIC_PLATFORM_URL=

# Obligatoria en production, opcional en staging. Correo de contacto aprobado (se usa en mailto:).
NEXT_PUBLIC_CONTACT_EMAIL=

# Opcional. Teléfono en formato E.164, ej.: +573001234567. Vacío = no se muestra.
NEXT_PUBLIC_CONTACT_PHONE=
